# Ringo-Star environment variable reference
# Both the Node.js model server and the Android Gradle build use the environment
# variables below directly. Neither loads this file automatically.
# To use these values, export them in your terminal as described in README.md.
# Empty optional values preserve the defaults implemented in the source code.
# No credentials or private model weights are included.

# Node.js API (server/server.js)
HOST=127.0.0.1
PORT=3000

# Optional custom directory for four converted model binaries
# Leave blank to use server/ringo_cloud_storage/download/
RINGO_MODEL_DIR=

# Android configuration (android/app/build.gradle)
# Blank: debug builds use the emulator-host URL http://10.0.2.2:3000.
# Physical devices need a reachable server URL; release downloads need HTTPS.
RINGO_MODEL_SERVER_URL=

# Optional build-time SHA-256 pins, one 64-hex-character digest for each model.
# Leave blank if no independently trusted hash is available.
RINGO_MODEL_SHA256_GEMMA2B=
RINGO_MODEL_SHA256_FALCON_RW1B=
RINGO_MODEL_SHA256_STABLE_LM3B=
RINGO_MODEL_SHA256_PHI2=
